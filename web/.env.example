# Copy to .env.local for local development; set the same names in the Vercel project for
# production. All of these are read on the server only: none is exposed to the browser.

# LiveKit Cloud project (same values as the agent's)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The agent the token dispatches (main.py registers as "riley")
AGENT_NAME=riley

# Cloudflare Turnstile. Unset in local development: Cloudflare's always-pass test keys are used.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis, for the call counters. Vercel's Upstash integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead, which also work. Unset in local development: counts stay in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits (these are the defaults). 4 calls a day keeps the page inside the $2.50 monthly LLM
# credit; one live call at a time while Riley is on the Gemini free tier (lib/gatekeeper.ts).
CALLS_PER_VISITOR_PER_HOUR=3
CALLS_PER_DAY=4
MAX_LIVE_CALLS=1
