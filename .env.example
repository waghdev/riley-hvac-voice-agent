# Copy to .env and fill in. Never commit .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
# LLM on LiveKit Inference, paid from the Build plan's free credit (e.g. google/gemini-3.1-flash-lite)
LLM_MODEL=
# Optional; unset keeps the model default (keep it unset for Gemini 3 models)
LLM_TEMPERATURE=
# Deepgram Aura-2 voice, chosen by listening (see docs/decisions.md)
TTS_VOICE=
# Call-center background sound: office, crowded or off; volume is a gain (office ~1.0-2.5, crowded ~0.1-0.2)
AMBIENT_SOUND=
AMBIENT_VOLUME=
# Fallback only: Gemini free tier with the Google key above (slow; see docs/decisions.md)
GEMINI_MODEL=
AGENT_ENV=dev
MAX_CALL_SECONDS=300
MOCK_CRM_URL=http://localhost:8080

# Web call page (web/.env.local); secrets stay server-side
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAX_CALLS_PER_IP_PER_HOUR=3
MAX_SESSIONS_PER_DAY=40
