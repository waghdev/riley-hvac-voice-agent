# Copy to .env and fill in. Never commit .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
# Model id as shown in Google AI Studio (check current Flash model)
GEMINI_MODEL=
AGENT_ENV=dev
MAX_CALL_SECONDS=300
MOCK_CRM_URL=http://localhost:8080

# Web call page (web/.env.local); secrets stay server-side
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAX_CALLS_PER_IP_PER_HOUR=3
MAX_SESSIONS_PER_DAY=40
