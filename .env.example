# Copy to .env and fill in. Never commit .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
# Riley's LLM. A Gemini id (default gemini-3.5-flash-lite) uses the Google key above on the
# free tier; a provider/model id (e.g. google/gemini-3.1-flash-lite) uses LiveKit Inference credit
LLM_MODEL=
# Optional; unset keeps the model default (keep it unset for Gemini 3 models)
LLM_TEMPERATURE=
# Deepgram Aura-2 voice, chosen by listening (see docs/decisions.md)
TTS_VOICE=
# Call-center background sound: office, crowded or off; volume is a gain (default office at 2.5)
AMBIENT_SOUND=
AMBIENT_VOLUME=
# Keyboard typing while Riley thinks; 0 turns it off (default 0.35)
THINKING_VOLUME=
# The QA grader's model (qa/grade_call.py; default gemini-3.5-flash-lite)
GEMINI_MODEL=
AGENT_ENV=dev
MAX_CALL_SECONDS=300
# The mock CRM (uv run uvicorn mock_crm.app:from_env --factory --port 8080). Unset: leads
# wait in the local outbox (data/outbox.sqlite3) for scripts/redeliver_outbox.py
MOCK_CRM_URL=http://localhost:8080
# Where the calendar and outbox SQLite files live (default: data/)
DATA_DIR=
# Demo switch: make every calendar call this slow, to hear the filler line
CALENDAR_DELAY_SECONDS=

# Web call page: its settings live in web/.env.local (see web/.env.example) and in Vercel.
# Turnstile keys can sit here too, for safekeeping; the page doesn't read this file.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
